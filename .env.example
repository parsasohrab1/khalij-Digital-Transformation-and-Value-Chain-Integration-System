# ==============================================
# Khalij DVC - Environment Configuration Template
# Digital Transformation and Value Chain Integration
# Save a copy of this file as .env in the project root
# ==============================================

# ---------- General ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa

# ---------- PostgreSQL (transactional data / Data Mesh catalog) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=khalij_dvc
POSTGRES_USER=khalij_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DSN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------- TimescaleDB (time series of inventory, GPS, AIS) ----------
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5433
TIMESCALE_DB=khalij_dvc_ts
TIMESCALE_USER=khalij_admin
TIMESCALE_PASSWORD=change_me_strong_password
TIMESCALE_DSN=postgresql+psycopg2://${TIMESCALE_USER}:${TIMESCALE_PASSWORD}@${TIMESCALE_HOST}:5432/${TIMESCALE_DB}

# ---------- Redis (Command Center cache) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ---------- Kafka (separate topic per subsidiary - Data Mesh) ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ORDERS=dvc.orders
KAFKA_TOPIC_INVENTORY=dvc.inventory
KAFKA_TOPIC_LOGISTICS=dvc.logistics
KAFKA_TOPIC_PRICES=dvc.prices
KAFKA_TOPIC_ALERTS=dvc.alerts
KAFKA_TOPIC_SUBSIDIARY_PREFIX=dvc.subsidiary
KAFKA_CONSUMER_GROUP=khalij-dvc

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# ---------- Analytics / Optimization (patentable capability) ----------
DEMAND_FORECAST_HORIZON_DAYS=90
LP_SOLVER_TIME_LIMIT_SEC=30
HOLDING_MARGIN_OBJECTIVE=maximize
FORECAST_MODEL=ensemble
FORECAST_CACHE_TTL_SEC=120
DRIFT_THRESHOLD=0.25
SYNTHETIC_DATA_PATH=data/digital_value_chain_data_10k.csv

# ---------- Security (NFR-SEC-01 / NFR-SEC-02) ----------
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
TWO_FACTOR_REQUIRED=true
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
TLS_MIN_VERSION=TLSv1.3
FORCE_HTTPS=false
RATE_LIMIT_PER_MINUTE=120
AUDIT_LOG_ENABLED=true

# ---------- Scale / Availability (Phase 5) ----------
TARGET_AVAILABILITY=99.95%
TARGET_TPS=50000

# ---------- Service Ports ----------
API_GATEWAY_PORT=8000
DATA_INTEGRATION_PORT=8001
SUPPLY_CHAIN_ANALYTICS_PORT=8002
LOGISTICS_PORT=8003
ORDER_TO_CASH_PORT=8004
BI_REPORTING_PORT=8005
COMMAND_CENTER_PORT=8010
CUSTOMER_PORTAL_PORT=8011
